# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# LLM provider: openai_compatible (default) — covers LM Studio, Ollama /v1, vLLM, OpenAI
LLM_PROVIDER=openai_compatible

# OpenAI-compatible endpoint. Default is the cloud routerai aggregator;
# type a local URL at sbx-start.sh (or set this) for LM Studio / Ollama.
LLM_BASE_URL=https://routerai.ru/api/v1

# Chat / final-answer model served by the LLM backend
LLM_MODEL=openai/gpt-5.6-luna

# API key for the chat (and, by default, embedding) provider. Required for
# the cloud default; leave empty for local LM Studio / Ollama.
LLM_API_KEY=

# Path to the conversation-memory SQLite file. Default lives on the sandbox
# VM-local disk (~/.local/share/dev-helper-bot/memory.db) and survives bot
# restarts and sandbox pause; a full sandbox reset wipes it.
# MEMORY_DB_PATH=~/.local/share/dev-helper-bot/memory.db

# Path to the observability SQLite file (telemetry of agent runs).
# Same VM-local disk rule as memory.db. Rotation is manual: delete the file
# while the bot is stopped.
# OBS_DB_PATH=~/.local/share/dev-helper-bot/observability.db

# Path to the document RAG SQLite index (uploaded documents, chunks, vectors).
# Separate DB from memory.db: different lifecycle plus the sqlite-vec extension.
# Same VM-local disk rule. Deleting the file wipes every user's documents.
# RAG_DB_PATH=~/.local/share/dev-helper-bot/rag.db

# Embedding model for document indexing and search queries. Configured
# separately from LLM_MODEL and requested from an OpenAI-compatible
# POST /embeddings. EMBEDDING_DIM must match the model: bge-m3 is 1024.
# Changing the model invalidates the existing index — wipe RAG_DB_PATH
# and re-upload the documents.
# EMBEDDING_MODEL=baai/bge-m3
# EMBEDDING_DIM=1024
#
# Embeddings inherit LLM_BASE_URL / LLM_API_KEY unless a different provider
# is used. Set EMBEDDING_BASE_URL / EMBEDDING_API_KEY only then — sbx-start.sh
# does not pass them, so a .env override remains reachable from the sandbox.
# EMBEDDING_BASE_URL=
# EMBEDDING_API_KEY=

# Indexing limits. Raw upload size is checked before any heavy work; the text
# and chunk limits are checked after extraction and splitting.
# RAG_MAX_UPLOAD_BYTES=5000000
# RAG_MAX_EXTRACT_CHARS=300000
# RAG_MAX_CHUNKS_PER_DOC=800

# Virtual pricing for token accounting, $ per 1M tokens. Defaults 0.11 in /
# 0.60 out are an accounting value for before/after comparisons, not the
# price of the current default chat model. Cached tokens use the input price.
# OBS_PRICE_INPUT_PER_M=0.11
# OBS_PRICE_OUTPUT_PER_M=0.60

# Optional label stamped on every run of this bot process — used to mark
# experiments ("before"/"after") and filtered by the dashboard (--label).
# OBS_LABEL=

# Port of the in-process observability web dashboard (change add-obs-web-dashboard).
# The dashboard binds to 127.0.0.1 only (loopback, no LAN) and runs in the same
# process as the bot's long-polling. Open http://127.0.0.1:8765/ on the host
# while the bot is running. If the port is busy, the bot will not start
# polling — set OBS_WEB_PORT to a free port. CLI scripts (obs-dashboard.py,
# obs-audit.py) remain available and read the same DB directly.
# OBS_WEB_PORT=8765
#
# Bind host of the dashboard. Default 127.0.0.1 (host loopback, no LAN).
# Inside an sbx sandbox the start script overrides this to 0.0.0.0: the sbx
# port forward enters the VM via its network interface (not loopback), so a
# loopback bind inside the VM is unreachable from the host. 0.0.0.0 inside
# the VM is still safe — sbx ports publishes only on the host's loopback.
# OBS_WEB_HOST=127.0.0.1

# --- optional: pin routerai to the cheap openai/flex tier ---
# The default LLM_BASE_URL / LLM_MODEL already go through routerai. Uncomment
# to pin the model string to the flex tier. The `@...` suffix is part of the
# model name (aggregator routing params) and is passed through as is;
# allow_fallbacks=false forbids silent migration to the pricier base tier.
# Prices are ₽ per 1M tokens (flex tier: input 11.26 / output 67.54) —
# used for the price-based cost *estimate*; actual provider billing arrives
# in usage.cost and is stored separately as billed_cost (₽).
# LLM_BASE_URL=https://routerai.ru/api/v1
# LLM_MODEL=openai/gpt-5.6-luna@provider=openai/flex&allow_fallbacks=false
# LLM_API_KEY=sk-...
# OBS_PRICE_INPUT_PER_M=11.26
# OBS_PRICE_OUTPUT_PER_M=67.54
