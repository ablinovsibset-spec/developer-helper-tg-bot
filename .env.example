# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# LLM provider: openai_compatible (default) — covers LM Studio, Ollama /v1, vLLM, OpenAI
LLM_PROVIDER=openai_compatible

# OpenAI-compatible endpoint. Default points to local LM Studio
LLM_BASE_URL=http://localhost:1234/v1

# Model name served by the LLM backend
LLM_MODEL=openai/gpt-oss-20b

# API key for cloud providers; leave empty for local LM Studio / Ollama
LLM_API_KEY=

# Path to the conversation-memory SQLite file. Default lives on the sandbox
# VM-local disk (~/.local/share/dev-helper-bot/memory.db) and survives bot
# restarts and sandbox pause; a full sandbox reset wipes it.
# MEMORY_DB_PATH=~/.local/share/dev-helper-bot/memory.db
