# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# LLM provider: openai_compatible (default) — covers LM Studio, Ollama /v1, vLLM, OpenAI
LLM_PROVIDER=openai_compatible

# OpenAI-compatible endpoint. Default points to local LM Studio
LLM_BASE_URL=http://localhost:1234/v1

# Model name served by the LLM backend
LLM_MODEL=openai/gpt-oss-20b

# API key for cloud providers; leave empty for local LM Studio / Ollama
LLM_API_KEY=

# Path to the conversation-memory SQLite file. Default lives on the sandbox
# VM-local disk (~/.local/share/dev-helper-bot/memory.db) and survives bot
# restarts and sandbox pause; a full sandbox reset wipes it.
# MEMORY_DB_PATH=~/.local/share/dev-helper-bot/memory.db

# Path to the observability SQLite file (telemetry of agent runs).
# Same VM-local disk rule as memory.db. Rotation is manual: delete the file
# while the bot is stopped.
# OBS_DB_PATH=~/.local/share/dev-helper-bot/observability.db

# Virtual pricing for token accounting, $ per 1M tokens. Defaults follow the
# gpt-oss-20b launch prices in the OpenAI API (0.11 in / 0.60 out); the local
# model actually costs $0 — the cost is an accounting value for before/after
# comparisons. Cached tokens are billed at the input price.
# OBS_PRICE_INPUT_PER_M=0.11
# OBS_PRICE_OUTPUT_PER_M=0.60

# Optional label stamped on every run of this bot process — used to mark
# experiments ("before"/"after") and filtered by the dashboard (--label).
# OBS_LABEL=

# Port of the in-process observability web dashboard (change add-obs-web-dashboard).
# The dashboard binds to 127.0.0.1 only (loopback, no LAN) and runs in the same
# process as the bot's long-polling. Open http://127.0.0.1:8765/ on the host
# while the bot is running. If the port is busy, the bot will not start
# polling — set OBS_WEB_PORT to a free port. CLI scripts (obs-dashboard.py,
# obs-audit.py) remain available and read the same DB directly.
# OBS_WEB_PORT=8765
#
# Bind host of the dashboard. Default 127.0.0.1 (host loopback, no LAN).
# Inside an sbx sandbox the start script overrides this to 0.0.0.0: the sbx
# port forward enters the VM via its network interface (not loopback), so a
# loopback bind inside the VM is unreachable from the host. 0.0.0.0 inside
# the VM is still safe — sbx ports publishes only on the host's loopback.
# OBS_WEB_HOST=127.0.0.1

# --- routerai with a pinned cheap endpoint (openai/flex) ---
# Uncomment to route the bot through the commercial routerai aggregator
# with the model string pinned to the flex tier. The `@...` suffix is part
# of the model name (aggregator routing params) and is passed through as is;
# allow_fallbacks=false forbids silent migration to the pricier base tier.
# Prices are ₽ per 1M tokens (flex tier: input 11.26 / output 67.54) —
# used for the price-based cost *estimate*; actual provider billing arrives
# in usage.cost and is stored separately as billed_cost (₽).
# LLM_BASE_URL=https://routerai.ru/api/v1
# LLM_MODEL=openai/gpt-5.6-luna@provider=openai/flex&allow_fallbacks=false
# LLM_API_KEY=sk-...
# OBS_PRICE_INPUT_PER_M=11.26
# OBS_PRICE_OUTPUT_PER_M=67.54
